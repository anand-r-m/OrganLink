# PostgreSQL connection string used by the API (server/db.js), db:reset and db:rules.
DATABASE_URL=postgresql://localhost:5432/organlink
SESSION_SECRET=change-me-in-real-deployments

# Mock/live switch (frontend). Leave unset (or comment out) for mock mode:
# the app renders src/data/mock*.js fixtures and needs no database.
# Set to `api` for live mode: the app calls /api/* through the Vite proxy.
# Restart the dev server after changing this.
# VITE_DATA_SOURCE=api
